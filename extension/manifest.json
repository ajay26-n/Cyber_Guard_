{
  "manifest_version": 3,
  "name": "CyberGuard — AI Threat & Phishing Protection",
  "version": "1.0.0",
  "description": "Real-time AI threat intelligence and automatic phishing site blocking.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CyberGuard URL Scanner"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cyberguard-extension@cyberguard.local"
    }
  }
}
